# Copy this file to a file called .env and adapt its values;
# They will be used as your local environment variables

# The folder containing the input data generated by MADRAT.
MADRAT_OUTPUTFOLDER=madrat_output
# The folder containing the raw input data for the ATLAS trade model.
ATLAS_RAW_DATA = /p/projects/transience/ATLAS_raw_data/
# The folder containing the exported MFA demand trajectories for ATLAS.
ATLAS_MFA_INPUT_DIRECTORY = remind-mfa/data
# path must lead to chrome/chromium executable; only needed for plotly figures to be saved as png
BROWSER_PATH=/path/to/chrome
