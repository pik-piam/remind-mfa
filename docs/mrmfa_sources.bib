@article{gao_evaluating_2025,
	title = {Evaluating the potential to reduce the global demand for polymers},
	volume = {223},
	issn = {0921-3449},
	url = {https://www.sciencedirect.com/science/article/pii/S0921344925003969},
	doi = {10.1016/j.resconrec.2025.108518},
	abstract = {The widespread use of polymers leads to several environmental challenges, particularly greenhouse gas emissions and ecosystem contamination. Yet, the global mitigation potential of possible interventions has not yet been quantified. This requires a high-resolution model to anticipate the future demand for polymers, and the potential impacts of demand reduction and recycling. Here, we present such a model to estimate the production, trade, consumption, and the accumulation in service of 14 polymers across eight world regions. The results show that current trends could lead to doubling the annual global demand and waste generation of polymers by 2100. But increased demand could be avoided by either limiting the stock of polymers in service globally or by maximising the deployment of mechanical and chemical recycling technologies. A reduction in demand for polymers from current levels seems challenging, which may present additional obstacles to the decarbonization of this sector.},
	urldate = {2026-03-12},
	journal = {Resources, Conservation and Recycling},
	author = {Gao, Yunhu and Cabrera Serrenho, André},
	month = sep,
	year = {2025},
	keywords = {Material flow analysis, Chemical recycling, Mechanical recycling, Plastics, Polymers, Demand reduction},
	pages = {108518},
}
